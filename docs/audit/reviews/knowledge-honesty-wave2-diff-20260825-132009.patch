++KnowledgeDoc
++  id:          string     // 旧文档 = 现 frontmatter name；新文档稳定 slug/uuid
++  title:       string     // 展示 + prompt 标题；CJK
++  filename:    string     // OS 安全；可与 id.md 相同
++  type:        site_knowledge | domain_knowledge | path-inferred
