+                try {
+                  ws.send(
+                    JSON.stringify({
+                      type: "auth.failed",
+                      error: nego.error,
+                      ...authOkProtocolFields(),
+                    }),
+                  )
+                } catch { /* closing */ }
+              }
+              try { ws.terminate() } catch { /* closing */ }
+              return
+            }
+            st.authenticated = true
+            clearTimeout(st.timer)
+            logger.info("ws.authenticated", { protocol_version: nego.negotiated })
