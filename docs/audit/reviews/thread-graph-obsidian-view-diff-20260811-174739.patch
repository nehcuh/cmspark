+/**
+ * Toolbar-scale mark (16 / 32): integer-aligned ring + spark.
+ * Portal noise looks muddy at ≤32px; Chrome uses these sizes on the toolbar
+ * (often 16 CSS px → 32 physical on Retina). Keep high contrast, hard edges.
+ */
+function renderCrispMark(size, colorScheme = "green") {
+  const buf = Buffer.alloc(size * size * 4)
+  const cx = (size - 1) / 2
+  const cy = (size - 1) / 2
+  // Outer radius leaves ~1px padding; stroke ~15–20% of size
+  const rOuter = size * 0.42
+  const stroke = Math.max(1.25, size * 0.16)
+  const rInner = rOuter - stroke
+
+  const palettes = {
+    // Neon green ring on deep void — matches portal brand at small size
+    green:  { ring: [57, 255, 80], core: [20, 40, 24], spark: [220, 255, 220], void: [8, 12, 10] },
+    // Quiet Premium indigo fallback
+    indigo: { ring: [99, 102, 241], core: [30, 27, 75], spark: [238, 242, 255], void: [15, 23, 42] },
+  }
+  const pal = palettes[colorScheme] || palettes.green
+
+  for (let py = 0; py < size; py++) {
+    for (let px = 0; px < size; px++) {
+      const idx = (py * size + px) * 4
+      const dx = px - cx
+      const dy = py - cy
+      const dist = Math.sqrt(dx * dx + dy * dy)
+
+      // Annular ring with ~1px AA (no multi-pixel glow)
+      const outerEdge = 1 - smoothstep(rOuter - 0.5, rOuter + 0.5, dist)
+      const innerEdge = smoothstep(rInner - 0.5, rInner + 0.5, dist)
+      const aRing = outerEdge * innerEdge
+
+      // Interior disc (portal hole)
+      const aCore = 1 - smoothstep(rInner - 0.55, rInner + 0.15, dist)
+
+      // Center spark: axis-aligned diamond (reads at 16px)
+      const ax = Math.abs(dx)
+      const ay = Math.abs(dy)
+      const sparkR = Math.max(1.2, size * 0.13)
+      const diamond = (ax + ay) / Math.SQRT2
+      const aSpark = (1 - smoothstep(sparkR - 0.45, sparkR + 0.35, diamond)) * aCore
+
+      let r = 0, g = 0, b = 0, a = 0
+
+      if (aCore > 0.01) {
+        r = pal.void[0]
+        g = pal.void[1]
+        b = pal.void[2]
+        a = aCore
+      }
+      if (aSpark > 0.02) {
+        const t = Math.min(1, aSpark)
+        r = Math.round(r * (1 - t) + pal.spark[0] * t)
+        g = Math.round(g * (1 - t) + pal.spark[1] * t)
+        b = Math.round(b * (1 - t) + pal.spark[2] * t)
+        a = Math.max(a, t)
+      }
+      if (aRing > 0.01) {
+        const t = aRing
+        r = Math.round(r * (1 - t) + pal.ring[0] * t)
+        g = Math.round(g * (1 - t) + pal.ring[1] * t)
+        b = Math.round(b * (1 - t) + pal.ring[2] * t)
+        a = Math.min(1, a * (1 - t) + t)
+      }
+
+      // Outside stays transparent — soft ambient glow is what made the toolbar icon look soft/blurry
+      buf[idx] = r
+      buf[idx + 1] = g
+      buf[idx + 2] = b
+      buf[idx + 3] = Math.min(255, Math.round(a * 255))
+    }
+  }
+  return buf
+}
+
+/** Render at 2× then box-downsample — sharper than drawing noise at native size. */
+function renderPortalSupersampled(size, colorScheme = "green") {
+  if (size <= 32) return renderCrispMark(size, colorScheme)
+  const hi = size * 2
+  const src = renderPortal(hi, colorScheme)
+  const out = Buffer.alloc(size * size * 4)
+  for (let y = 0; y < size; y++) {
+    for (let x = 0; x < size; x++) {
+      let r = 0, g = 0, b = 0, a = 0
+      for (let oy = 0; oy < 2; oy++) {
+        for (let ox = 0; ox < 2; ox++) {
+          const si = ((y * 2 + oy) * hi + (x * 2 + ox)) * 4
+          const sa = src[si + 3] / 255
+          r += src[si] * sa
+          g += src[si + 1] * sa
+          b += src[si + 2] * sa
+          a += sa
+        }
+      }
+      const di = (y * size + x) * 4
+      if (a < 1e-6) {
+        out[di] = out[di + 1] = out[di + 2] = out[di + 3] = 0
+      } else {
+        out[di] = Math.round(r / a)
+        out[di + 1] = Math.round(g / a)
+        out[di + 2] = Math.round(b / a)
+        out[di + 3] = Math.min(255, Math.round((a / 4) * 255))
+      }
+    }
+  }
+  return out
+}
