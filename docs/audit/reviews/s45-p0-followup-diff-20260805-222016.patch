+/**
+ * Build fleet.stop_all payload + confirm copy from fleet scope.
+ * S45 multi-lane P0: when scope is `run`, pass orchestrator_run_id so companion
+ * only stops that run's workers (message-router already supports the filter).
+ * Parent/none remain process-wide with honest confirm copy until parent filter lands.
+ */
+export function buildFleetStopAllMessage(scope: FleetScope): {
+  type: "fleet.stop_all"
+  orchestrator_run_id?: string
+  confirmText: string
+  stopTitle: string
+} {
+  if (scope.kind === "run") {
+    return {
+      type: "fleet.stop_all",
+      orchestrator_run_id: scope.runId,
+      confirmText:
+        "鍋滄褰撳墠 run 鐨勫叏閮ㄥ瓙浠诲姟锛熷皢涓璇?run 涓?worker LLM銆佹嫆缁濆緟纭锛屽苟閲婃斁鐩稿叧 tab 閿併€?,
+      stopTitle: "鍋滄褰撳墠 run 鐨勫叏閮?worker",
+    }
+  }
+  if (scope.kind === "parent") {
+    return {
+      type: "fleet.stop_all",
+      confirmText:
+        "鍋滄瀛愪换鍔★紵褰撳墠灏嗕腑姝㈣繘绋嬪唴鍏ㄩ儴 worker锛堟棤娉曚粎鎸変細璇濊繃婊わ級锛屽苟閲婃斁鐩稿叧 tab 閿併€?,
+      stopTitle: "鍋滄杩涚▼鍐呭叏閮?worker锛堜細璇濇棤娉曞崟鐙繃婊わ級",
+    }
+  }
+  return {
+    type: "fleet.stop_all",
+    confirmText:
+      "娓呯悊杩涚▼鍐呭叏閮?worker 娈嬬暀锛熷皢涓鍏ㄩ儴 worker LLM銆佹嫆缁濆緟纭锛屽苟閲婃斁鐩稿叧 tab 閿併€?,
+    stopTitle: "褰撳墠浼氳瘽鏃犲瓙浠诲姟鍒楄〃锛涘叏鍋滀細浣滅敤鍒拌繘绋嬪唴鍏ㄩ儴 worker",
