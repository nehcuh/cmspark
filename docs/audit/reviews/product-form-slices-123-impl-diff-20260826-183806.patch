+
+test("updateKnowledge ignores WS-smuggled site/type", () => {
+  knowledgeDir()
+  const engine = new SkillEngine()
+  const doc = engine.importKnowledge(`---
+name: stay-global
+description: d
+type: domain_knowledge
+---
+body
+`)
+  engine.updateKnowledge(doc.id, {
+    title: "stay-global",
