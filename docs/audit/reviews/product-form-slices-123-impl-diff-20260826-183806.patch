+  assert.match(src, /rejectAll\(\s*"disconnect"\s*,\s*ws\s*\)/)
+  assert.match(src, /activeTrayConfirmsByWs\.get\(\s*ws\s*\)/)
+  assert.doesNotMatch(src, /activeTrayConfirmsByWs\.get\(\s*pickAuthenticatedClientWs/)
+  assert.doesNotMatch(
