+/** Outbound MCP public surface (ADR-022 Phase 0c). */
+
+export {
+  OUTBOUND_MCP_ALLOWLIST,
+  OUTBOUND_MCP_EXFIL_CLASS,
+  OUTBOUND_DISCLOSURE_ZH,
+  isOutboundAllowed,
+  isOutboundForbidden,
