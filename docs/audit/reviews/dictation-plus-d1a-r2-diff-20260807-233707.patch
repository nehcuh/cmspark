+        queueMicrotask(() => rec.onstart?.(new Event("start")))
+      },
+      stop() {},
+      abort() {},
+      onstart: null,
+      onend: null,
+      onerror: null,
+      onresult: null,
+    }
+    instances.push(rec)
+    return rec
+  } as unknown as new () => object
+
+  const g = globalThis as any
+  const prev = g.SpeechRecognition
+  g.SpeechRecognition = Ctor
+
+  let errors = 0
+  const adapter = createWebSpeechAdapter({
+    onStart: () => {},
+    onResult: () => {},
