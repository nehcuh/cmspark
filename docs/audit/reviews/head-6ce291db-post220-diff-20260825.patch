+        ["github", "未启用"],
+      ],
+    };
+    const titles = { talk: "对话", pack: "场景", know: "知识", skill: "技能", mcp: "MCP" };
+    const logHtml = {
+      talk: `<div class="bubble me"><div class="who">你</div><p>把今天的站会收成纪要，待办单列。</p></div>
+             <div class="bubble"><div class="who">助手</div><p>好。先按时间线收三点结论，再列出待办。完整格式仍可之后导出。</p></div>`,
+      pack: `<div class="bubble"><div class="who">场景</div><p>点左侧一项即套到当前对话。不升 Trust。需要确认的场景走托盘原生窗，不经过 Chrome。</p></div>`,
+      know: `<div class="bubble"><div class="who">知识</div><p>勾选挂到本对话（USE）。导入用系统文件框 + 确认，不经过侧栏。</p></div>`,
+      skill: `<div class="bubble"><div class="who">技能</div><p>列表来自 Companion。安装/开关在这里完成。</p></div>`,
+      mcp: `<div class="bubble"><div class="who">MCP</div><p>已连接的服务器可直接给本轮用。添加服务器用原生表单。</p></div>`,
+    };
+
+    const hud = document.getElementById("hud");
+    const listBody = document.getElementById("listBody");
+    const listTitle = document.getElementById("listTitle");
+    const log = document.getElementById("log");
+    const chev = document.getElementById("chev");
+
+    function renderList(sec) {
+      listTitle.textContent = titles[sec];
+      listBody.innerHTML = lists[sec].map(([t, s, on]) =>
+        `<button class="item" ${on ? 'aria-current="true"' : ""} type="button">${t}${s ? `<small>${s}</small>` : ""}</button>`
+      ).join("");
+      log.innerHTML = logHtml[sec];
+    }
+    renderList("talk");
+
+    document.querySelectorAll(".ico").forEach((btn) => {
+      btn.addEventListener("click", () => {
+        document.querySelectorAll(".ico").forEach((b) => b.removeAttribute("aria-current"));
+        btn.setAttribute("aria-current", "true");
+        renderList(btn.dataset.sec);
+      });
+    });
+
+    function setExpanded(on) {
+      hud.classList.toggle("expanded", on);
+      hud.classList.toggle("collapsed", !on);
+      chev.textContent = on ? "⌃" : "⌄";
+      document.getElementById("tOpen").setAttribute("aria-pressed", on);
+      document.getElementById("tFold").setAttribute("aria-pressed", !on);
+    }
+    document.getElementById("tOpen").onclick = () => setExpanded(true);
+    document.getElementById("tFold").onclick = () => setExpanded(false);
+    chev.onclick = () => setExpanded(!hud.classList.contains("expanded"));
+  </script>
+</body>
+</html>
