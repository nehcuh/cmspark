++  const user = (opts.userText || "").trim()
++  if (user) return user
++  const images = opts.images || 0
++  const docs = opts.docs || 0
++  if (images > 0 && docs > 0) return "请查看附件"
++  if (images > 0) return images === 1 ? "请看这张图" : "请看这些图片"
++  if (docs > 0) return "请分析我上传的文件"
