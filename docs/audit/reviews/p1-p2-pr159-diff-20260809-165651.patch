+// 8 New 0.5.0 surfaces: voice / meeting / outbound MCP
+let p8 = ctx;
+p8 += "DIMENSION: New 0.5.0 product surfaces deep dive (voice, meeting, dictation, outbound MCP, Windows Python discovery).\n";
