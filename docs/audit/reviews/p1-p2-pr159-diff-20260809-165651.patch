+    "properties": #{
+        "executive_summary": #{ "type": "string" },
+        "overall_score": #{ "type": "number" },
+        "grade": #{ "type": "string" },
+        "score_dashboard": #{ "type": "string" },
+        "confirmed_critical": #{ "type": "number" },
+        "confirmed_high": #{ "type": "number" },
+        "top_risks": #{ "type": "array", "maxItems": 15, "items": #{ "type": "string" } },
