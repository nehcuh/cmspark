+            "maxItems": 12,
+            "items": #{
+                "type": "object",
+                "required": ["id", "severity", "title", "evidence", "file", "impact", "fix_hint"],
+                "properties": #{
+                    "id": #{ "type": "string" },
+                    "severity": #{ "type": "string" },
+                    "title": #{ "type": "string" },
+                    "evidence": #{ "type": "string" },
+                    "file": #{ "type": "string" },
+                    "impact": #{ "type": "string" },
+                    "fix_hint": #{ "type": "string" },
+                    "prior_status": #{ "type": "string" },
+                },
+            },
+        },
+        "open_questions": #{ "type": "array", "maxItems": 5, "items": #{ "type": "string" } },
+    },
+};
+
+let synth_schema = #{
+    "type": "object",
+    "required": [
+        "executive_summary",
+        "overall_score",
+        "grade",
+        "score_dashboard",
+        "confirmed_critical",
+        "confirmed_high",
+        "top_risks",
+        "action_plan",
+        "delta_vs_prior",
+        "dimension_scores"
