+  }, [pkg.markdown])
+
+  if (!open) return null
+
+  const workspaceLabel = workspaceRoot
+    ? workspaceRoot.split(/[/\\]/).filter(Boolean).slice(-1)[0] || workspaceRoot
+    : "（未绑定）"
+
+  return (
+    <div
