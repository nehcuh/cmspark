+  const tabLeaseTools = deps?.TAB_LEASE_TOOLS ?? TAB_LEASE_TOOLS
+  const isMa = deps?.isMultiAgentThread ?? isMultiAgentThread
+  const anyHeld = deps?.anyTabLeaseHeld ?? anyTabLeaseHeld
