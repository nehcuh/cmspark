+        }
+      }
+    }
+    // host_computer vs any tab lease (Q4): block Chrome window ops while tabs leased
+    if (toolName === "host_computer" && anyHeld()) {
+      const blob = JSON.stringify(finalParams || {}).toLowerCase()
+      const chromeHint =
