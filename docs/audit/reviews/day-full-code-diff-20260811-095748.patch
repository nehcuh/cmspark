+export async function runMultiAgentToolPregate(
+  ctx: ToolPregateCtx,
+  deps?: ToolPregateDeps,
+): Promise<ToolPregateResult> {
+  const {
+    toolName,
+    toolCallId,
+    startedAt,
+    actingThreadId,
+    isOutboundMcpCall,
+    logToolFinish,
+    getThreadManager,
+    hasPendingForTab,
+    toolDisplayNameZh,
