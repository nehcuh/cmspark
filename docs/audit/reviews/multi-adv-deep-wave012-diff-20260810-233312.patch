+    armUnattended({ confirmation_phrase: SECURITY_ARM_CONFIRM_PHRASE })
+    assert.equal(isUnattendedArmed(), true)
+    // executor.ts reL2: if (isUnattendedArmed()) return true without confirm
+  })
+})
