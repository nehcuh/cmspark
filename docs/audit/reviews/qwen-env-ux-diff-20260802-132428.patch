++import type { AppEntry } from "./types"
++
++/** Env keys allowed into CLI child (explicit allowlist only). */
++const ENV_ALLOW = new Set([
++  "PATH",
++  "Path",
++  "HOME",
++  "USERPROFILE",
++  "HOMEDRIVE",
++  "HOMEPATH",
++  "SystemRoot",
++  "SYSTEMROOT",
++  "TEMP",
++  "TMP",
++  "TMPDIR",
++  "LANG",
++  "LC_ALL",
++  "LC_CTYPE",
++  "ComSpec",
++  "PATHEXT",
++  "NUMBER_OF_PROCESSORS",
++  "PROCESSOR_ARCHITECTURE",
++  "OS",
++  "TERM",
++])
