++export interface CliSubcommand {
++  name: string
++  description?: string
++  risk: CliRisk
++  flags?: CliFlagSpec[]
++  positionals?: CliPositionalSlot[]
++  timeout_ms?: number
++  max_output_bytes?: number
++}
