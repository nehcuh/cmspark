+++          }
+++        }
+++      }
+++    }
+++    if (s.positionals !== undefined) {
+++      if (!Array.isArray(s.positionals)) return `subcommand "${s.name}" positionals must be an array`
+++      if (s.positionals.length > 16) return `subcommand "${s.name}" positionals cap is 16`
