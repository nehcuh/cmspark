++export function truncateCliOutput(s: string, maxChars = CLI_TRUNCATE_CHARS): string {
++  if (s.length <= maxChars) return s
++  return s.slice(0, maxChars) + `\n…[truncated ${s.length - maxChars} chars]`
++}
