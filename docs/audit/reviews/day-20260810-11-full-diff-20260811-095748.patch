+-    logger.info("mcp.allow_dir.denied", { dir: pre.dir, reason: decision.reason })
+-    return {
+-      retried: true,
+-      ok: false,
+-      error:
+-        `User declined adding MCP allow-dir ${pre.dir}. Access denied. Underlying: ${opts.rawErr}`,
+-    }
