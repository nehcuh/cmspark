+-  const pre = canOfferAllowDirExpand({
+-    serverName: opts.route.serverName,
+-    rawErr: opts.rawErr,
+-    params: opts.params,
+-  })
+-  if (!pre.offer) {
+-    // Not applicable — leave original error; do not claim we retried
+-    return { retried: false }
+-  }
