+++  board_complete: "L2",
+++  skill_install: "L2",
+++}
+++
+++export function surfaceLevelForTool(name: string): SurfaceLevel {
+++  return SURFACE_BY_TOOL[name] || "L0"
+++}
+++
+++export function toolsAtSurface(level: SurfaceLevel): ReadonlySet<string> {
+++  const out = new Set<string>()
