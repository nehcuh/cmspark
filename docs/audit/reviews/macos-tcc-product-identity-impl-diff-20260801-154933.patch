+# Prefer extracting __TEXT,__info_plist via otool; fall back to strings.
+PLIST_TMP=$(mktemp)
+if otool -s __TEXT __info_plist "${OUTPUT_BIN}" 2>/dev/null | tail -n +3 | xxd -r -p >"${PLIST_TMP}" 2>/dev/null \
+  && plutil -lint "${PLIST_TMP}" >/dev/null 2>&1; then
