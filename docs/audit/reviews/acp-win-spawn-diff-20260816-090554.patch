+export async function openWindowsWithPref(
+  scriptPath: string,
+  cwd: string,
+  pref: string | undefined,
+): Promise<{ appLabel: string }> {
+  const n = normalizeLocalTerminalApp(pref).toLowerCase()
+  const wantWt = n === "auto" || n === "wt" || n === "windowsterminal" || n === "windows terminal"
+  const wantStart = n === "cmd" || n === "powershell" || n === "conhost" || n === "auto"
+  const psArgs = [
+    "-NoExit",
+    "-NoLogo",
+    "-ExecutionPolicy",
+    "Bypass",
+    "-File",
+    scriptPath,
+  ]
+  if (wantWt) {
+    const wt = findWindowsTerminalExe()
+    if (wt) {
+      try {
+        await spawnDetachedWin(wt, ["-d", cwd, "--", "powershell.exe", ...psArgs])
+        return { appLabel: "Windows Terminal" }
+      } catch {
+        if (n !== "auto") {
+          throw new Error("Windows Terminal failed to launch")
+        }
+      }
+    } else if (n !== "auto") {
+      throw new Error("Windows Terminal (wt.exe) not found")
+    }
+  }
+  if (wantStart || n === "auto") {
+    const comspec = process.env.ComSpec || "cmd.exe"
+    const line = `start "CMspark" powershell.exe ${psArgs.map((a) => (/\s/.test(a) ? `"${a}"` : a)).join(" ")}`
+    await spawnDetachedWin(comspec, ["/d", "/s", "/c", line])
+    return { appLabel: "Windows Console" }
+  }
+  throw new Error(`terminal pref "${pref}" is not supported on Windows (use auto / wt / cmd)`)
+}
