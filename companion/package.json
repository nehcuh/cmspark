{
  "name": "cmspark-agent",
  "version": "0.5.9",
  "description": "Local companion for CMspark Browser Agent — manages LLM calls, skills, threads, and operation history. Now with cross-platform system tray.",
  "bin": {
    "cmspark-agent": "./dist/index.js"
  },
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "prebuild": "node scripts/generate-tray-icons.mjs",
    "build": "tsc && node -e \"const fs=require('fs'),p=require('path');fs.mkdirSync('dist/computer',{recursive:true});fs.copyFileSync('src/computer/qwen-vl-worker.py','dist/computer/qwen-vl-worker.py');process.platform!=='win32'&&fs.chmodSync('dist/index.js',0o755)\"",
    "test": "node -e \"require('fs').rmSync('.test-dist',{recursive:true,force:true})\" && tsc -p tsconfig.test.json && node scripts/run-tests.mjs",
    "start": "node dist/index.js start",
    "dev": "tsx src/index.ts start",
    "daemon:start": "node dist/index.js daemon start --daemonize",
    "daemon:stop": "node dist/index.js daemon stop",
    "daemon:status": "node dist/index.js daemon status",
    "tray": "node dist/index.js tray",
    "tray:status": "node dist/index.js tray status",
    "tray:rebuild": "node dist/index.js tray rebuild",
    "menu-bar": "node dist/index.js menu-bar",
    "build:host": "bash src/host-use/darwin/build-host.sh",
    "stage:win-scripts": "node -e \"const fs=require('fs'),path=require('path');const src=path.join('src','host-use','win','scripts');const dst=path.join('dist','host-scripts-win');fs.mkdirSync(dst,{recursive:true});for(const f of fs.readdirSync(src)){if(f.endsWith('.ps1'))fs.copyFileSync(path.join(src,f),path.join(dst,f))}console.log('staged win scripts -> '+dst)\"",
    "postinstall": "node ../scripts/verify-systray2.js && node ../scripts/build-swift-tray.js",
    "bundle:exe": "node scripts/run-esbuild-bundle.mjs",
    "build:exe": "npm run build && npm run stage:win-scripts && npm run bundle:exe"
  },
  "dependencies": {
    "@agentclientprotocol/sdk": "^1.3.0",
    "@modelcontextprotocol/sdk": "^1.0.4",
    "@types/js-yaml": "^4.0.9",
    "adm-zip": "^0.6.0",
    "gray-matter": "^4.0.3",
    "js-yaml": "4.3.1",
    "node-notifier": "^10.0.1",
    "officeparser": "^7.2.3",
    "onnxruntime-node": "^1.29.0",
    "openai": "^4.52.0",
    "pdf-parse": "^1.1.1",
    "pdfjs-dist": "^4.0.0",
    "sql.js": "^1.14.1",
    "systray2": "^2.1.4",
    "ws": "^8.17.0",
    "zod": "^3.23.0"
  },
  "devDependencies": {
    "@types/adm-zip": "^0.5.8",
    "@types/node": "^20.14.0",
    "@types/ws": "^8.5.10",
    "esbuild": "0.28.1",
    "tsx": "^4.11.0",
    "typescript": "^5.4.5"
  },
  "overrides": {
    "adm-zip": "^0.6.0",
    "js-yaml": "4.3.1",
    "gray-matter": {
      "js-yaml": "3.15.1"
    },
    "officeparser": {
      "pdfjs-dist": "6.2.108"
    }
  }
}
