<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>com.apple.security.automation.apple-events</key>
    <true/>
    <!--
      SPIKE B1 (adversary-approach-c-round1.txt):
      Required for dlopen("/System/Library/PrivateFrameworks/SkyLight.framework").
      Reverts S-P0-2 library validation lockdown shipped in v1.3 Batch 1.
      This is the documented .NET MAUI sandbox-escape primitive — DO NOT ship
      to production without re-deriving the threat model in
      docs/decisions/v1.3/spike-daemon-threat-model.md.
    -->
    <key>com.apple.security.cs.disable-library-validation</key>
    <true/>
    <key>com.apple.security.cs.allow-unsigned-executable-memory</key>
    <false/>
    <key>com.apple.security.cs.allow-jit</key>
    <false/>
</dict>
</plist>
