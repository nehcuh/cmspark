[Unit]
Description=CMspark Browser Agent Companion
Documentation=https://github.com/cmspark/cmspark
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
ExecStart=:"{{NODE_PATH}}" "{{CMSPARK_AGENT_PATH}}" daemon start
ExecStop=:"{{NODE_PATH}}" "{{CMSPARK_AGENT_PATH}}" daemon stop
Restart=on-failure
RestartSec=30
StartLimitInterval=300
StartLimitBurst=3

# Environment
Environment="NODE_ENV=production"
Environment="CMSPARK_DATA_DIR={{DATA_DIR}}"

# Logging
StandardOutput=append:{{DATA_DIR}}/logs/stdout.log
StandardError=append:{{DATA_DIR}}/logs/stderr.log

[Install]
WantedBy=default.target
