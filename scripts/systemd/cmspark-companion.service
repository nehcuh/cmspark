[Unit]
Description=CMspark Browser Agent Companion
Documentation=https://github.com/cmspark/cmspark
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
ExecStart=:"{{NODE_PATH}}" "{{CMSPARK_AGENT_PATH}}" daemon start
ExecStop=:"{{NODE_PATH}}" "{{CMSPARK_AGENT_PATH}}" daemon stop
Restart=on-failure
RestartSec=30
StartLimitInterval=300
StartLimitBurst=3

# Environment
Environment="NODE_ENV=production"
Environment="CMSPARK_DATA_DIR={{HOME}}/.cmspark-agent"

# Logging
StandardOutput=append:{{HOME}}/.cmspark-agent/logs/stdout.log
StandardError=append:{{HOME}}/.cmspark-agent/logs/stderr.log

[Install]
WantedBy=default.target
